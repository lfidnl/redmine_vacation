<%# Rendered through a hook, so only core helpers are available here. %>
<% messages = VacationMessage.displayed_for(User.current) %>
<% if messages.any? %>
  <div id="vacation-messages">
    <% messages.each do |message| %>
      <%
        text = message.text
        if message.append_dates?
          period = message.single_day? ? format_date(message.date_from) :
                     "#{format_date(message.date_from)} - #{format_date(message.date_until)}"
          text = "#{text} (#{period})"
        end
      %>
      <div class="flash vacation-message" style="<%= message.css_style %>">
        <%= l(:text_vacation_banner, name: message.user.name, text: text) %>
      </div>
    <% end %>
  </div>
<% end %>
