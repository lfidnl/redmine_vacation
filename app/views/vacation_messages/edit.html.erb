<h2><%= link_to l(:label_vacation_messages), vacation_messages_path %> &#187; <%= @vacation_message.text %></h2>

<%= labelled_form_for @vacation_message, url: vacation_message_path(@vacation_message), html: { id: 'vacation-message-form' } do |f| %>
  <%= render partial: 'form', locals: { f: f } %>
  <%= submit_tag l(:button_save) %>
<% end %>

<% html_title l(:label_vacation_messages) %>
