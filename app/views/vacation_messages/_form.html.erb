<%= error_messages_for @vacation_message %>

<div class="box tabular">
  <% if manager? && @vacation_message.new_record? %>
    <p>
      <label for="vacation_message_user_id"><%= l(:field_vacation_user) %></label>
      <%= select_tag 'vacation_message[user_id]', vacation_owner_options(@vacation_message.user),
                     id: 'vacation_message_user_id' %>
    </p>
  <% elsif @vacation_message.user != User.current %>
    <p>
      <label><%= l(:field_vacation_user) %></label>
      <%= @vacation_message.user.name %>
    </p>
  <% end %>
  <p>
    <%= f.date_field :date_from, required: true, size: 10 %>
    <%= calendar_for 'vacation_message_date_from' %>
  </p>
  <p>
    <%= f.date_field :date_until, required: true, size: 10 %>
    <%= calendar_for 'vacation_message_date_until' %>
  </p>
  <p>
    <%= f.text_field :text, required: true, size: 60, maxlength: 255 %>
    <em class="info"><%= l(:text_vacation_text_info) %></em>
  </p>
  <p>
    <%= f.check_box :append_dates %>
  </p>
  <p>
    <%= f.select :substitute_id, vacation_substitute_options(@vacation_message), include_blank: true %>
  </p>
  <p>
    <%= f.select :visibility, vacation_visibility_options, {}, class: 'vacation-visibility' %>
    <em class="info"><%= l(:text_vacation_visibility_info) %></em>
  </p>
  <p class="vacation-recipients">
    <%= f.select :principal_ids, vacation_recipient_options(@vacation_message), {},
          multiple: true, size: 10 %>
    <em class="info"><%= l(:text_vacation_recipients_info) %></em>
  </p>
  <p class="vacation-projects">
    <%= f.select :project_ids, vacation_project_options(@vacation_message), {},
          multiple: true, size: 10 %>
    <em class="info"><%= l(:text_vacation_projects_info) %></em>
  </p>
  <p class="vacation-projects">
    <%= f.check_box :include_subprojects %>
  </p>
  <p>
    <%= f.check_box :show_to_self %>
  </p>
</div>

<fieldset class="box tabular">
  <legend><%= l(:label_vacation_banner) %></legend>
  <p>
    <%= f.check_box :show_banner %>
    <em class="info"><%= l(:text_vacation_show_banner_info) %></em>
  </p>
  <div class="vacation-banner-options">
    <p>
      <%= f.color_field :color, required: true, class: 'vacation-color' %>
      <span class="vacation-presets">
        <% VacationMessage::COLOR_PRESETS.each do |name, hex| %>
          <button type="button" class="vacation-preset" data-color="<%= hex %>"
                  style="background-color: <%= hex %>;"
                  title="<%= l("label_vacation_color_#{name}") %>"></button>
        <% end %>
      </span>
    </p>
    <p>
      <%= f.number_field :lead_days, min: 0, max: VacationMessage::MAX_LEAD_DAYS, size: 4 %>
      <em class="info"><%= l(:text_vacation_lead_days_info) %></em>
    </p>
    <p>
      <label><%= l(:label_preview) %></label>
      <span class="flash vacation-message vacation-preview"
            style="<%= @vacation_message.css_style if @vacation_message.color.to_s.match?(/\A#\h{6}\z/) %>"
            data-name="<%= @vacation_message.user.name %>"
            data-template="<%= l(:text_vacation_banner, name: '%NAME%', text: '%TEXT%') %>"
            data-template-upcoming="<%= l(:text_vacation_banner_upcoming, name: '%NAME%', text: '%TEXT%') %>"
            data-substitute-label="<%= l(:field_vacation_substitute_id) %>"
            data-today="<%= User.current.today.iso8601 %>"
            <%# Same format format_date uses, so the preview matches the banner. %>
            data-date-format="<%= Setting.date_format.presence || ::I18n.t('date.formats.default') %>"
            data-month-names="<%= ::I18n.t('date.month_names').to_json %>"
            data-abbr-month-names="<%= ::I18n.t('date.abbr_month_names').to_json %>">
        <%= l(:text_vacation_banner, name: @vacation_message.user.name, text: @vacation_message.text) %>
      </span>
    </p>
  </div>
</fieldset>
