<% messages = tab[:messages] %>
<% if messages.empty? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
  <div class="autoscroll">
    <table class="list vacation-messages">
      <thead>
        <tr>
          <th><%= l(:label_vacation_period) %></th>
          <th><%= l(:field_vacation_text) %></th>
          <th><%= l(:field_vacation_substitute_id) %></th>
          <th><%= l(:label_vacation_visible_for) %></th>
          <th><%= l(:label_vacation_banner) %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% today = User.current.today %>
        <% messages.each do |message| %>
          <tr class="<%= 'vacation-active' if message.active_on?(today) %>">
            <td class="period"><%= vacation_period(message) %></td>
            <td class="text">
              <span class="vacation-swatch" style="<%= message.css_style %>"></span>
              <%= message.text %>
            </td>
            <td class="substitute"><%= link_to_user(message.substitute) if message.substitute %></td>
            <td class="visibility"><%= vacation_visibility_summary(message) %></td>
            <td class="banner">
              <%= checked_image message.show_banner? %>
              <% if message.show_banner? && message.lead_days > 0 %>
                <span class="vacation-lead"><%= l(:label_vacation_lead_short, count: message.lead_days) %></span>
              <% end %>
            </td>
            <td class="buttons">
              <%= link_to sprite_icon('edit', l(:button_edit)), edit_vacation_message_path(message), class: 'icon icon-edit' %>
              <%= link_to sprite_icon('del', l(:button_delete)), vacation_message_path(message),
                    method: :delete, data: { confirm: l(:text_are_you_sure) },
                    class: 'icon icon-del' %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
