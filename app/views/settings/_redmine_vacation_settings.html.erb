<div class="box tabular">
  <p>
    <label><%= l(:label_vacation_allowed_groups) %></label>
    <%= hidden_field_tag 'settings[allowed_group_ids][]', '', id: nil %>
    <%= select_tag 'settings[allowed_group_ids][]',
          options_from_collection_for_select(
            Group.givable.sorted, :id, :name,
            Array(@settings['allowed_group_ids']).map(&:to_s)),
          multiple: true, size: 8 %>
    <em class="info"><%= l(:text_vacation_allowed_groups_info) %></em>
  </p>

  <p>
    <label><%= l(:label_vacation_manager_groups) %></label>
    <%= hidden_field_tag 'settings[manager_group_ids][]', '', id: nil %>
    <%= select_tag 'settings[manager_group_ids][]',
          options_from_collection_for_select(
            Group.givable.sorted, :id, :name,
            Array(@settings['manager_group_ids']).map(&:to_s)),
          multiple: true, size: 8 %>
    <em class="info"><%= l(:text_vacation_manager_groups_info) %></em>
  </p>

  <p>
    <label><%= l(:label_vacation_hint_days) %></label>
    <%= number_field_tag 'settings[hint_days]', @settings['hint_days'], min: 1, max: 365, size: 4 %>
    <em class="info"><%= l(:text_vacation_hint_days_info) %></em>
  </p>
</div>

<fieldset class="box tabular">
  <legend><%= l(:label_vacation_welcome_block) %></legend>
  <p>
    <label><%= l(:label_vacation_welcome_enabled) %></label>
    <%= hidden_field_tag 'settings[welcome_enabled]', '0', id: nil %>
    <%= check_box_tag 'settings[welcome_enabled]', '1', @settings['welcome_enabled'] == '1' %>
  </p>
  <p>
    <label><%= l(:label_vacation_block_users) %></label>
    <%= render partial: 'vacation_messages/user_picker',
               locals: { name: 'settings[welcome_user_ids]',
                         users: User.where(id: VacationMessage.ids_from(@settings['welcome_user_ids'])).sorted.to_a } %>
    <br><em class="info"><%= l(:text_vacation_block_users_info) %></em>
  </p>
</fieldset>
